    <!-- =============================================== -->
    <!-- PATRONYMES TYPIQUES PAR ETHNIE                 -->
    <!-- =============================================== -->
    
    <Patronyme rdf:about="#Ouedraogo">
        <nom>Ouédraogo</nom>
        <signification>Fils de cheval ou descendant royal</signification>
        <origine>Lignée royale mossi, nom du fondateur de Tenkodogo</origine>
        <aPourEthnie rdf:resource="#Mossi"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Sawadogo">
        <nom>Sawadogo</nom>
        <signification>Maître de la terre, gardien du terroir</signification>
        <origine>Lignée des tengansob (maîtres de la terre) chez les Mossi</origine>
        <aPourEthnie rdf:resource="#Mossi"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Kaboré">
        <nom>Kaboré</nom>
        <signification>Celui qui fait parler, porte-parole</signification>
        <origine>Tradition mossi, fonction de ministre royal</origine>
        <aPourEthnie rdf:resource="#Mossi"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Diallo">
        <nom>Diallo</nom>
        <signification>Descendant noble, celui qui est élevé</signification>
        <origine>Lignée peule aristocratique répandue au Sahel</origine>
        <aPourEthnie rdf:resource="#Peuls"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Barry">
        <nom>Barry</nom>
        <signification>Guerrier, celui qui combat</signification>
        <origine>Caste des guerriers peuls</origine>
        <aPourEthnie rdf:resource="#Peuls"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Traoré">
        <nom>Traoré</nom>
        <signification>Descendant du lion, lignée noble</signification>
        <origine>Patronyme mandé très répandu chez plusieurs ethnies</origine>
        <aPourEthnie rdf:resource="#Bobo"/>
        <aPourEthnie rdf:resource="#Sénoufo"/>
        <aPourEthnie rdf:resource="#Marka"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Coulibaly">
        <nom>Coulibaly</nom>
        <signification>Celui qui n'a pas de pirogue, terrien</signification>
        <origine>Patronyme mandé répandu chez les Bobo et Sénoufo</origine>
        <aPourEthnie rdf:resource="#Bobo"/>
        <aPourEthnie rdf:resource="#Sénoufo"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Ouattara">
        <nom>Ouattara</nom>
        <signification>Descendant de Wattara, lignée commerçante</signification>
        <origine>Lignée de commerçants dioula-mandé</origine>
        <aPourEthnie rdf:resource="#Bobo"/>
        <aPourEthnie rdf:resource="#Sénoufo"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Sankara">
        <nom>Sankara</nom>
        <signification>Celui qui donne la joie</signification>
        <origine>Patronyme mossi de la région de Yako</origine>
        <aPourEthnie rdf:resource="#Mossi"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Compaoré">
        <nom>Compaoré</nom>
        <signification>Celui qui rassemble les hommes</signification>
        <origine>Patronyme mossi du centre</origine>
        <aPourEthnie rdf:resource="#Mossi"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Lompo">
        <nom>Lompo</nom>
        <signification>Chef, celui qui commande</signification>
        <origine>Patronyme gurunsi répandu chez les Kasséna</origine>
        <aPourEthnie rdf:resource="#Kasséna"/>
        <aPourEthnie rdf:resource="#Gurunsi"/>
    </Patronyme>
    
    <Patronyme rdf:about="#Tiendrebéogo">
        <nom>Tiendrébéogo</nom>
        <signification>Dieu merci, remerciement divin</signification>
        <origine>Patronyme mossi exprimant la gratitude</origine>
        <aPourEthnie rdf:resource="#Mossi"/>
    </Patronyme>

