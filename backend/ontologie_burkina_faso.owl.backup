<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologie/burkina-faso#"
         xml:base="http://www.semanticweb.org/ontologie/burkina-faso"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xml="http://www.w3.org/XML/1998/namespace"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologie/burkina-faso">
        <rdfs:label>Ontologie des Langues et Ethnies du Burkina Faso</rdfs:label>
        <rdfs:comment>Ontologie complète sur toutes les ethnies du Burkina Faso</rdfs:comment>
        <owl:versionInfo>2.0</owl:versionInfo>
    </owl:Ontology>
    
    <!-- =============================================== -->
    <!-- CLASSES PRINCIPALES SELON LE DIAGRAMME UML    -->
    <!-- =============================================== -->
    
    <owl:Class rdf:about="#Ethnie">
        <rdfs:label>Ethnie</rdfs:label>
        <rdfs:comment>Communauté humaine partageant une culture, une langue et une histoire commune</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Patronyme">
        <rdfs:label>Patronyme</rdfs:label>
        <rdfs:comment>Nom de famille transmis héréditairement, caractéristique d'une ethnie</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Langue">
        <rdfs:label>Langue</rdfs:label>
        <rdfs:comment>Système structuré de communication propre à un groupe humain</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Dialecte">
        <rdfs:label>Dialecte</rdfs:label>
        <rdfs:comment>Variante géographique ou sociale d'une langue</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#FamilleLinguistique">
        <rdfs:label>Famille Linguistique</rdfs:label>
        <rdfs:comment>Ensemble de langues apparentées issues d'une langue ancestrale commune</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#Localite">
        <rdfs:label>Localité</rdfs:label>
        <rdfs:comment>Région géographique où une ethnie est établie</rdfs:comment>
    </owl:Class>
    
    <owl:Class rdf:about="#LocalisationEthnie">
        <rdfs:label>Localisation Ethnie</rdfs:label>
        <rdfs:comment>Informations sur la répartition d'une ethnie dans une région</rdfs:comment>
    </owl:Class>
    
    <!-- =============================================== -->
    <!-- ÉNUMÉRATIONS SELON LE DIAGRAMME               -->
    <!-- =============================================== -->
    
    <owl:Class rdf:about="#StatutNationalEnum">
        <rdfs:label>Statut National Enum</rdfs:label>
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#MAJORITAIRE"/>
                    <rdf:Description rdf:about="#MINORITAIRE"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    
    <owl:NamedIndividual rdf:about="#MAJORITAIRE">
        <rdf:type rdf:resource="#StatutNationalEnum"/>
        <rdfs:label>MAJORITAIRE</rdfs:label>
    </owl:NamedIndividual>
    
    <owl:NamedIndividual rdf:about="#MINORITAIRE">
        <rdf:type rdf:resource="#StatutNationalEnum"/>
        <rdfs:label>MINORITAIRE</rdfs:label>
    </owl:NamedIndividual>
    
    <!-- =============================================== -->
    <!-- PROPRIÉTÉS D'OBJET SELON LE DIAGRAMME         -->
    <!-- =============================================== -->
    
    <owl:ObjectProperty rdf:about="#aPourEthnie">
        <rdfs:label>aPourEthnie</rdfs:label>
        <rdfs:domain rdf:resource="#Patronyme"/>
        <rdfs:range rdf:resource="#Ethnie"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#estEthnieDe">
        <rdfs:label>estEthnieDe</rdfs:label>
        <rdfs:domain rdf:resource="#Ethnie"/>
        <rdfs:range rdf:resource="#Patronyme"/>
        <owl:inverseOf rdf:resource="#aPourEthnie"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#parle">
        <rdfs:label>parle</rdfs:label>
        <rdfs:domain rdf:resource="#Ethnie"/>
        <rdfs:range rdf:resource="#Langue"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#estParlePar">
        <rdfs:label>estParlePar</rdfs:label>
        <rdfs:domain rdf:resource="#Langue"/>
        <rdfs:range rdf:resource="#Ethnie"/>
        <owl:inverseOf rdf:resource="#parle"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#estLocalise">
        <rdfs:label>estLocalise</rdfs:label>
        <rdfs:domain rdf:resource="#Ethnie"/>
        <rdfs:range rdf:resource="#Localite"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#estLocaliteDe">
        <rdfs:label>estLocaliteDe</rdfs:label>
        <rdfs:domain rdf:resource="#Localite"/>
        <rdfs:range rdf:resource="#Ethnie"/>
        <owl:inverseOf rdf:resource="#estLocalise"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#aPourDialecte">
        <rdfs:label>aPourDialecte</rdfs:label>
        <rdfs:domain rdf:resource="#Langue"/>
        <rdfs:range rdf:resource="#Dialecte"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#estDialecteDe">
        <rdfs:label>estDialecteDe</rdfs:label>
        <rdfs:domain rdf:resource="#Dialecte"/>
        <rdfs:range rdf:resource="#Langue"/>
        <owl:inverseOf rdf:resource="#aPourDialecte"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#aPourFamilleLinguistique">
        <rdfs:label>aPourFamilleLinguistique</rdfs:label>
        <rdfs:domain rdf:resource="#Langue"/>
        <rdfs:range rdf:resource="#FamilleLinguistique"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#estFamilleLinguistiqueDe">
        <rdfs:label>estFamilleLinguistiqueDe</rdfs:label>
        <rdfs:domain rdf:resource="#FamilleLinguistique"/>
        <rdfs:range rdf:resource="#Langue"/>
        <owl:inverseOf rdf:resource="#aPourFamilleLinguistique"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#statutNational">
        <rdfs:label>statutNational</rdfs:label>
        <rdfs:domain rdf:resource="#Ethnie"/>
        <rdfs:range rdf:resource="#StatutNationalEnum"/>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="#statutLocal">
        <rdfs:label>statutLocal</rdfs:label>
        <rdfs:domain rdf:resource="#LocalisationEthnie"/>
        <rdfs:range rdf:resource="#StatutNationalEnum"/>
    </owl:ObjectProperty>
    
    <!-- =============================================== -->
    <!-- PROPRIÉTÉS DE DONNÉES SELON LE DIAGRAMME      -->
    <!-- =============================================== -->
    
    <owl:DatatypeProperty rdf:about="#nom">
        <rdfs:label>nom</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#signification">
        <rdfs:label>signification</rdfs:label>
        <rdfs:domain rdf:resource="#Patronyme"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#origine">
        <rdfs:label>origine</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#populationEstimee">
        <rdfs:label>populationEstimee</rdfs:label>
        <rdfs:domain rdf:resource="#Ethnie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#description">
        <rdfs:label>description</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#synonyme">
        <rdfs:label>synonyme</rdfs:label>
        <rdfs:domain rdf:resource="#Ethnie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#tradition">
        <rdfs:label>tradition</rdfs:label>
        <rdfs:domain rdf:resource="#Ethnie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#pourcentageNational">
        <rdfs:label>pourcentageNational</rdfs:label>
        <rdfs:domain rdf:resource="#Ethnie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#nombreLocuteur">
        <rdfs:label>nombreLocuteur</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#latitude">
        <rdfs:label>latitude</rdfs:label>
        <rdfs:domain rdf:resource="#Localite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#longitude">
        <rdfs:label>longitude</rdfs:label>
        <rdfs:domain rdf:resource="#Localite"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    
    <owl:DatatypeProperty rdf:about="#pourcentageRegional">
        <rdfs:label>pourcentageRegional</rdfs:label>
        <rdfs:domain rdf:resource="#LocalisationEthnie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    
    <!-- =============================================== -->
    <!-- FAMILLES LINGUISTIQUES                         -->
    <!-- =============================================== -->
    
    <FamilleLinguistique rdf:about="#NigerCongoGur">
        <nom>Niger-Congo (Gur/Voltaïque)</nom>
        <origine>Afrique de l'Ouest</origine>
        <description>Principale famille linguistique du Burkina Faso, comprenant les langues voltaïques</description>
    </FamilleLinguistique>
    
    <FamilleLinguistique rdf:about="#NigerCongoMande">
        <nom>Niger-Congo (Mandé)</nom>
        <origine>Afrique de l'Ouest</origine>
        <description>Branche mandé de la famille Niger-Congo</description>
    </FamilleLinguistique>
    
    <FamilleLinguistique rdf:about="#AfroAsiatique">
        <nom>Afro-asiatique</nom>
        <origine>Afrique du Nord et Moyen-Orient</origine>
        <description>Famille incluant les langues peules et haoussa</description>
    </FamilleLinguistique>
    
    <FamilleLinguistique rdf:about="#NiloSaharienne">
        <nom>Nilo-Saharienne</nom>
        <origine>Afrique centrale et orientale</origine>
        <description>Famille incluant les langues songhaï et zarma</description>
    </FamilleLinguistique>
    
    <!-- =============================================== -->
    <!-- RÉGIONS GÉOGRAPHIQUES DU BURKINA FASO         -->
    <!-- =============================================== -->
    
    <Localite rdf:about="#Centre">
        <nom>Centre</nom>
        <description>Région administrative comprenant Ouagadougou, territoire principal des Mossi</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.3714</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.5197</longitude>
    </Localite>
    
    <Localite rdf:about="#PlateauCentral">
        <nom>Plateau Central</nom>
        <description>Région administrative au centre du pays, territoire historique des Mossi</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.0000</longitude>
    </Localite>
    
    <Localite rdf:about="#CentreNord">
        <nom>Centre-Nord</nom>
        <description>Région administrative au nord du Centre, zone de contact entre Mossi et pasteurs</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">13.5000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.5000</longitude>
    </Localite>
    
    <Localite rdf:about="#CentreEst">
        <nom>Centre-Est</nom>
        <description>Région administrative à l'est du Centre, territoire des Bissa</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5000</longitude>
    </Localite>
    
    <Localite rdf:about="#CentreOuest">
        <nom>Centre-Ouest</nom>
        <description>Région administrative à l'ouest du Centre, zone de diversité ethnique</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-2.5000</longitude>
    </Localite>
    
    <Localite rdf:about="#CentreSud">
        <nom>Centre-Sud</nom>
        <description>Région administrative au sud du Centre, territoire des Gurunsi</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">11.0000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.0000</longitude>
    </Localite>
    
    <Localite rdf:about="#Est">
        <nom>Est</nom>
        <description>Région administrative orientale, territoire des Gourmantché</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5000</longitude>
    </Localite>
    
    <Localite rdf:about="#HautsBassins">
        <nom>Hauts-Bassins</nom>
        <description>Région administrative occidentale, territoire des Bobo et Sénoufo</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">11.1784</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-4.2982</longitude>
    </Localite>
    
    <Localite rdf:about="#BoucleDuMouhoun">
        <nom>Boucle du Mouhoun</nom>
        <description>Région administrative nord-ouest, territoire des Bwaba, Marka et Samo</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.5000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-3.0000</longitude>
    </Localite>
    
    <Localite rdf:about="#Cascades">
        <nom>Cascades</nom>
        <description>Région administrative sud-ouest, territoire des Sénoufo et Lobi</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.5000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-4.5000</longitude>
    </Localite>
    
    <Localite rdf:about="#SudOuest">
        <nom>Sud-Ouest</nom>
        <description>Région administrative méridionale, territoire des Lobi et Dagara</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">10.0000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-3.0000</longitude>
    </Localite>
    
    <Localite rdf:about="#Sahel">
        <nom>Sahel</nom>
        <description>Région administrative septentrionale, territoire des Peuls et Touaregs</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">14.5000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-1.0000</longitude>
    </Localite>
    
    <Localite rdf:about="#Nord">
        <nom>Nord</nom>
        <description>Région administrative septentrionale, territoire des Zarma et Songhaï</description>
        <latitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">13.5000</latitude>
        <longitude rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">-2.0000</longitude>
    </Localite>
    
    <!-- =============================================== -->
    <!-- LANGUES PRINCIPALES AVEC DONNÉES RÉELLES      -->
    <!-- =============================================== -->
    
    <Langue rdf:about="#More">
        <nom>Mooré</nom>
        <description>Langue principale des Mossi, parlée par plus de 12 millions de locuteurs</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12600000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoGur"/>
    </Langue>
    
    <Langue rdf:about="#Fulfuldé">
        <nom>Fulfuldé</nom>
        <description>Langue des Peuls, langue afro-asiatique</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1600000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#AfroAsiatique"/>
    </Langue>
    
    <Langue rdf:about="#Gourmanchéma">
        <nom>Gourmanchéma</nom>
        <description>Langue des Gourmantché de l'est du Burkina Faso</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1200000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoGur"/>
    </Langue>
    
    <Langue rdf:about="#Dioula">
        <nom>Dioula</nom>
        <description>Langue véhiculaire du commerce, parlée par plusieurs ethnies</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">800000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoMande"/>
    </Langue>
    
    <Langue rdf:about="#Bwamu">
        <nom>Bwamu</nom>
        <description>Langue des Bwaba de la boucle du Mouhoun</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">280000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoGur"/>
    </Langue>
    
    <Langue rdf:about="#Lyélé">
        <nom>Lyélé</nom>
        <description>Langue des Lyélé du centre-sud</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoGur"/>
    </Langue>
    
    <Langue rdf:about="#Kassem">
        <nom>Kassem</nom>
        <description>Langue des Kasséna du centre-sud</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">140000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoGur"/>
    </Langue>
    
    <Langue rdf:about="#Dagara">
        <nom>Dagara</nom>
        <description>Langue des Dagara du sud-ouest</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">235000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoGur"/>
    </Langue>
    
    <Langue rdf:about="#Lobi">
        <nom>Lobi</nom>
        <description>Langue des Lobi du sud-ouest</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">350000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoGur"/>
    </Langue>
    
    <Langue rdf:about="#Sénoufo">
        <nom>Sénoufo</nom>
        <description>Langue des Sénoufo des Cascades</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">520000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoGur"/>
    </Langue>
    
    <Langue rdf:about="#Samo">
        <nom>Samo</nom>
        <description>Langue des Samo de la boucle du Mouhoun</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">190000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoMande"/>
    </Langue>
    
    <Langue rdf:about="#Marka">
        <nom>Marka</nom>
        <description>Langue des Marka de la boucle du Mouhoun</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">165000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NigerCongoMande"/>
    </Langue>
    
    <Langue rdf:about="#Zarma">
        <nom>Zarma</nom>
        <description>Langue des Zarma du nord</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NiloSaharienne"/>
    </Langue>
    
    <Langue rdf:about="#Songhaï">
        <nom>Songhaï</nom>
        <description>Langue des Songhaï du nord</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#NiloSaharienne"/>
    </Langue>
    
    <Langue rdf:about="#Haussa">
        <nom>Haussa</nom>
        <description>Langue des Haussa du nord et du sahel</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#AfroAsiatique"/>
    </Langue>
    
    <Langue rdf:about="#Tamachek">
        <nom>Tamachek</nom>
        <description>Langue des Touaregs du sahel</description>
        <nombreLocuteur rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30000</nombreLocuteur>
        <aPourFamilleLinguistique rdf:resource="#AfroAsiatique"/>
    </Langue>
    
    <!-- =============================================== -->
    <!-- ETHNIES PRINCIPALES AVEC DONNÉES RÉELLES      -->
    <!-- =============================================== -->
    
    <Ethnie rdf:about="#Mossi">
        <nom>Mossi</nom>
        <synonyme>Moosé, Moaga, Moose</synonyme>
        <description>Ethnie majoritaire du Burkina Faso, descendants du royaume Mossi avec le Moro Naba</description>
        <tradition>Royaume traditionnel avec hiérarchie nobles-roturiers, agriculture</tradition>
        <populationEstimee rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12600000</populationEstimee>
        <pourcentageNational rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">53.7</pourcentageNational>
        <statutNational rdf:resource="#MAJORITAIRE"/>
        <parle rdf:resource="#More"/>
        <estLocalise rdf:resource="#Centre"/>
        <estLocalise rdf:resource="#PlateauCentral"/>
        <estLocalise rdf:resource="#CentreNord"/>
        <estLocalise rdf:resource="#CentreEst"/>
        <estLocalise rdf:resource="#CentreOuest"/>
    </Ethnie>
    
    <Ethnie rdf:about="#Peuls">
        <nom>Peuls</nom>
        <synonyme>Fulbé, Foulbé, Fula, Pular</synonyme>
        <description>Ethnie d'éleveurs traditionnellement nomades répandue dans tout le Sahel</description>
        <tradition>Élevage transhumant, tradition islamique, organisation en castes</tradition>
